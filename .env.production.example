TRANSPORT=http
PORT=3100
NODE_ENV=production

# Protect MCP/admin-style routes.
ROUTER_API_KEY=replace-with-long-random-value
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_REQUIRED=true

# Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-1-region.pooler.supabase.com:6543/postgres

# Server-only secret for credential encryption. Rotate separately from DB password.
V2_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-plus-random-bytes

# Storage / local fallback paths.
V2_STORAGE_BUCKET=docrouter-v2-documents
V2_MAX_UPLOAD_BYTES=52428800
V2_UPLOAD_DIR=/data/v2-uploads
V2_EVENT_DIR=/data/v2-events
V2_PROFILE_DIR=/data/v2-profiles
V2_CREDENTIAL_DIR=/data/v2-credentials
V2_DOCUMENT_INTELLIGENCE_DIR=/data/v2-document-intelligence
ROUTER_STATE_DIR=/data/router-state

# Optional OCR override.
TESSERACT_CMD=tesseract
