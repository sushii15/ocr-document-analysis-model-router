{
  "name": "ocr-document-analysis-model-router",
  "version": "1.0.0",
  "description": "BYOK model router for OCR document analysis, invoice extraction, bank statement extraction, scanned PDFs, and long financial documents.",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node scripts/smoke-test.mjs && node scripts/persistence-smoke-test.mjs",
    "db:apply:router": "node scripts/apply-router-migration.mjs",
    "db:apply:all": "node scripts/apply-all-migrations.mjs"
  },
  "keywords": [
    "ocr",
    "document-analysis",
    "document-ai",
    "model-router",
    "llm-router",
    "pdf-extraction",
    "invoice-extraction",
    "bank-statement-extraction",
    "mcp-server",
    "byok"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.0",
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.6",
    "typescript": "^6.0.3"
  }
}
