TRANSPORT=http
PORT=3100
MAX_DECISIONS_LOG=10000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional HTTP protection for /mcp and dashboard routes. Health remains public.
ROUTER_API_KEY=

# Default persistence is a local JSON state file under .docrouter/router-state.
# Use ROUTER_PERSISTENCE=memory for ephemeral test/demo runs.
ROUTER_PERSISTENCE=file
ROUTER_STATE_DIR=.docrouter/router-state

# Reserved for the Supabase persistence adapter after project secrets are provided.
# Keep service/secret keys server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Migration-only Postgres connection string. Do not expose to clients.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=

# Legacy fallback only if your project has not migrated to new API keys.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Live provider execution. Without these, router_execute_request returns dry-run output.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional OpenAI-compatible self-hosted providers.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
VLLM_BASE_URL=
