{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    { "src": "api/server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/api/server.js" },
    { "src": "/api/v2/(.*)", "dest": "/api/server.js" },
    { "src": "/mcp", "dest": "/api/server.js" },
    { "src": "/health", "dest": "/api/server.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
